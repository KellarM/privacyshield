{
  "name": "ExposureProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "The legal name brokers publish"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prior or alternate names, maiden names, initials"
    },
    "birth_year": {
      "type": "string",
      "description": "Year of birth only"
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Current and past addresses"
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "country": {
      "type": "string",
      "description": "Determines which privacy law a removal request cites"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}