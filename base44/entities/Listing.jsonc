{
  "name": "Listing",
  "type": "object",
  "properties": {
    "broker_name": {
      "type": "string"
    },
    "broker_domain": {
      "type": "string"
    },
    "listing_url": {
      "type": "string"
    },
    "exposed_data": {
      "type": "string",
      "description": "What the listing shows, e.g. home address, phone, relatives"
    },
    "status": {
      "type": "string",
      "enum": [
        "found",
        "requested",
        "follow_up",
        "removed",
        "reappeared",
        "dismissed"
      ],
      "default": "found"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "likely",
        "possible",
        "confirmed"
      ]
    },
    "requested_date": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string"
    },
    "removed_date": {
      "type": "string"
    },
    "removal_request": {
      "type": "string",
      "description": "Generated statutory removal request text"
    },
    "request_subject": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "broker_name",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}